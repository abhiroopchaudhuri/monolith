{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monolith/ux-principles.schema.json",
  "title": "UXPrinciples",
  "type": "object",
  "required": ["inferred", "principles"],
  "properties": {
    "inferred": { "type": "boolean" },
    "principles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["name", "summary"],
        "properties": {
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
