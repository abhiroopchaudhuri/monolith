{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monolith/voice.schema.json",
  "title": "Voice",
  "type": "object",
  "required": ["inferred", "toneWords", "dos", "donts", "examplePhrases"],
  "properties": {
    "inferred": { "type": "boolean" },
    "toneWords": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "dos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule"],
        "properties": {
          "rule": { "type": "string" },
          "example": { "type": "string" }
        }
      }
    },
    "donts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule"],
        "properties": {
          "rule": { "type": "string" },
          "example": { "type": "string" }
        }
      }
    },
    "examplePhrases": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "bannedPhrases": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } }
  }
}
