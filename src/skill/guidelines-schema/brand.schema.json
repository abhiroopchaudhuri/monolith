{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monolith/brand.schema.json",
  "title": "Brand",
  "type": "object",
  "required": ["productName", "inferred", "paletteSemantics", "typographyFamilies"],
  "properties": {
    "productName": { "type": "string" },
    "inferred": { "type": "boolean" },
    "logoUsage": { "type": "string" },
    "paletteSemantics": {
      "type": "object",
      "description": "Map of palette role → token path",
      "additionalProperties": { "type": "string" },
      "examples": [{ "brand/primary": "color/brand/primary/default" }]
    },
    "typographyFamilies": {
      "type": "object",
      "required": ["body"],
      "properties": {
        "body": { "type": "string" },
        "heading": { "type": "string" },
        "mono": { "type": "string" }
      }
    },
    "voiceAnchors": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } }
  }
}
