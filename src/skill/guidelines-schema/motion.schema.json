{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monolith/motion.schema.json",
  "title": "Motion",
  "type": "object",
  "required": ["inferred", "durations", "easings", "when"],
  "properties": {
    "inferred": { "type": "boolean" },
    "durations": {
      "type": "object",
      "description": "Named durations in ms",
      "additionalProperties": { "type": "number" },
      "examples": [{ "fast": 120, "base": 200, "slow": 320 }]
    },
    "easings": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "when": {
      "type": "object",
      "properties": {
        "animate": { "type": "array", "items": { "type": "string" } },
        "doNotAnimate": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } }
  }
}
