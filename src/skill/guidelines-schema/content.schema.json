{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monolith/content.schema.json",
  "title": "Content",
  "type": "object",
  "required": ["inferred", "case", "numbers", "dates", "lists", "punctuation"],
  "properties": {
    "inferred": { "type": "boolean" },
    "case": {
      "type": "object",
      "properties": {
        "buttons":   { "enum": ["sentence", "title", "upper"] },
        "headings":  { "enum": ["sentence", "title"] },
        "labels":    { "enum": ["sentence", "title"] },
        "badges":    { "enum": ["sentence", "title", "upper"] }
      }
    },
    "numbers": {
      "type": "object",
      "properties": {
        "kpiFormat": { "type": "string" },
        "delta":     { "type": "string" }
      }
    },
    "dates": {
      "type": "object",
      "properties": {
        "display":  { "type": "string" },
        "relative": { "type": "boolean" }
      }
    },
    "lists": {
      "type": "object",
      "properties": {
        "oxfordComma":    { "type": "boolean" },
        "terminalPeriod": { "type": "boolean" }
      }
    },
    "punctuation": {
      "type": "object",
      "properties": {
        "quotes":       { "enum": ["straight", "curly"] },
        "ellipsis":     { "enum": ["three-dots", "unicode"] }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } }
  }
}
