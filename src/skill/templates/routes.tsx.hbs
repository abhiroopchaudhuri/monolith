import React from 'react';
import { Routes, Route } from 'react-router-dom';
{{#each screens}}
import {{this.component}} from './screens/{{this.folder}}';
{{/each}}

export function AppRoutes() {
  return (
    <Routes>
      {{#each screens}}
      <Route path="{{this.path}}" element={<{{this.component}} />} />
      {{/each}}
    </Routes>
  );
}
